# GPU type: nvidia or amd (set by setup script)
GPU_TYPE=nvidia

# Ports
FRONTEND_PORT=3000
STT_PORT=8080
TTS_PORT=8880
LLM_PORT=8081

# LLM backend (Plan #11): "lmstudio" (default) or "ollama".
#   lmstudio → orchestrator talks LM Studio's native /api/v0 API + auto-discovers
#              your whole LM Studio model library for the dashboard picker.
#   ollama   → original host-Ollama path.
LLM_BACKEND=lmstudio
# LM Studio server URL as seen from inside the orchestrator container. LM Studio
# must be "Served on Local Network" (binds 0.0.0.0) for host.docker.internal to work.
LMSTUDIO_URL=http://host.docker.internal:1234
# Model the "auto" brain falls back to when nothing is loaded (must exist in LM Studio).
LMSTUDIO_DEFAULT_MODEL=qwen/qwen3-4b-2507

# LLM settings (Ollama path)
LLM_MODEL_FILE=Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_CTX_SIZE=4096

# STT settings
WHISPER_MODEL=base.en
